{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": ["@playwright/mcp@latest"]
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--headless",
        "--isolated",
        "--executablePath=/opt/pw-browsers/chromium",
        "--chromeArg=--no-sandbox",
        "--chromeArg=--proxy-server=${HTTPS_PROXY}",
        "--no-usage-statistics"
      ]
    }
  }
}
